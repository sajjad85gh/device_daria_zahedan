# Add these as PRODUCT_SYSTEM_PROPERTIES (system.prop), You may use utilities as libinit if configuring for unified devices
ro.infinity.soc
ro.infinity.battery
ro.infinity.display
ro.infinity.camera

# Example Defintions
ro.infinity.soc=MediaTek Dimensity 7050
ro.infinity.battery=4700 mAh
ro.infinity.display=1080 x 2400, 120 Hz
ro.infinity.camera=50MP + 8MP + 2MP

# Also declare your Device Name with appropirate sepolicy rule(Take libinit in use if Unified)
ro.product.marketname

# Example Defintion
ro.product.marketname=Daria Bond 5G